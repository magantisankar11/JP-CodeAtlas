{
  "name": "@jci/analyzer-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue/JS/TS front-end analyzer for java-code-intel (read-only, emits graph-v1 NDJSON)",
  "scripts": {
    "analyze": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue/compiler-sfc": "3.5.44",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15"
  }
}
